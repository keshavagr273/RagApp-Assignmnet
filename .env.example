# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.kxkeood.mongodb.net/folioq?retryWrites=true&w=majority
MONGODB_USE_ATLAS=true

# Redis (Upstash or Local Redis)
REDIS_URL=rediss://default:<password>@<host>:6379

# Auth Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_32_char_minimum_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_32_char_minimum_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# LLM Providers (Anthropic, Gemini, Groq, or OpenAI)
# Option A: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-5

# Option B: Gemini (via OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_VISION_MODEL=gemini-2.5-flash

# Option C: OpenAI / Groq
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Embeddings (Cohere, Voyage, OpenAI, or Local Mock)
COHERE_API_KEY=your_cohere_api_key
# VOYAGE_API_KEY=your_voyage_key
# OPENAI_API_KEY=your_openai_key
EMBED_MODEL=embed-english-v3.0
EMBED_DIMENSIONS=1024

# File Storage (local or s3)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
STORAGE_TYPE=local

# S3 (optional for production)
# AWS_REGION=us-east-1
# AWS_BUCKET=my-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Ingestion Concurrency
INGESTION_CONCURRENCY=2
VISION_PAGE_CONCURRENCY=3
